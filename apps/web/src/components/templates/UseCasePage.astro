---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../sections/Breadcrumbs.astro';
import SinglePresetStage from '../islands/SinglePresetStage';
import CopyPromptButton from '../islands/CopyPromptButton';
import FaqDetails from '../sections/FaqDetails.astro';
import ActionTileCta from '../sections/ActionTileCta.astro';
import { SITE_URL, buildStudioUrl, localizePath, type Locale } from '../../config/site';
import { USE_CASE_PILLARS, type UseCasePillar } from '../../data/useCases';

interface Props {
  pillar: UseCasePillar;
  locale: Locale;
}

const { pillar, locale } = Astro.props;
const id = locale === 'id';
const pathname = localizePath(`/use-cases/${pillar.slug}`, locale);
const hubPath = localizePath('/use-cases', locale);
const otherPillars = USE_CASE_PILLARS.filter((p) => p.slug !== pillar.slug);

const breadcrumbs = [
  { name: 'MooScript', url: new URL(localizePath('/', locale), SITE_URL).toString() },
  { name: id ? 'Kegunaan' : 'Use cases', url: new URL(hubPath, SITE_URL).toString() },
  { name: pillar.shortTitle[locale], url: new URL(pathname, SITE_URL).toString() }
];

const trail = [
  { name: 'MooScript', href: localizePath('/', locale) },
  { name: id ? 'Kegunaan' : 'Use cases', href: hubPath },
  { name: pillar.shortTitle[locale] }
];

const L = {
  open: id ? 'Buka template di Studio' : 'Open preset in Studio',
  pipeline: 'WebCodecs Render Pipeline',
  related: id ? 'Alur produksi lainnya' : 'Related workflows',
  faq: id ? 'Pertanyaan umum' : 'Common questions'
};
---

<BaseLayout
  title={pillar.seoTitle[locale]}
  description={pillar.seoDescription[locale]}
  locale={locale}
  pathname={pathname}
  keywords={pillar.keywords[locale]}
  includeSoftwareSchema={true}
  faqs={pillar.faqs[locale]}
  breadcrumbs={breadcrumbs}
>
  <section class="field-lime w-full pb-20 pt-4 md:pb-28">
    <div class="frame">
      <Breadcrumbs trail={trail} />
      <h1 class="t-poster arrive mt-10" style="--d: 60ms;">{pillar.headline[locale]}</h1>
      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-14">
        <div class="lg:col-span-5">
          <p class="t-lead arrive max-w-[44ch]" style="--d: 180ms;">{pillar.lead[locale]}</p>
          <div class="arrive mt-8 flex flex-wrap items-center gap-3" style="--d: 300ms;">
            <a href={buildStudioUrl(pillar.presetSlug)} class="btn btn-dark">{L.open} &rarr;</a>
            <CopyPromptButton client:visible locale={locale} tone="dark" />
          </div>
        </div>
        <div data-ui class="lg:col-span-7">
          <SinglePresetStage client:load slug={pillar.presetSlug} locale={locale} tone="lime" />
        </div>
      </div>
    </div>
  </section>

  <section class="field-ground w-full py-24 md:py-40">
    <div class="frame grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <h2 class="t-sub" data-reveal>{pillar.architectureTitle[locale]}</h2>
        <div class="mt-8 flex flex-col gap-5" data-reveal style="--reveal-delay: 80ms;">
          {pillar.architectureParagraphs[locale].map((para) => <p class="max-w-[52ch] text-soft">{para}</p>)}
        </div>

        <figure class="mt-10 overflow-hidden bg-surface" data-reveal>
          <video
            data-ambient-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/stars-rise-over-la-silla-poster.jpg"
            width="854"
            height="480"
            aria-hidden="true"
            class="aspect-video w-full object-cover"
          >
            <source src="/media/stars-rise-over-la-silla.webm" type="video/webm" />
          </video>
        </figure>
      </div>

      <div class="flex flex-col gap-5 lg:col-span-7" data-reveal style="--reveal-delay: 100ms;">
        <div class="bg-surface p-6">
          <div class="mb-3 flex items-center justify-between text-[15px] text-muted">
            <span class="font-semibold text-ink">{pillar.codeTitle[locale]}</span>
            <span>MooTween API</span>
          </div>
          <pre class="overflow-x-auto text-[15px] leading-[1.6] text-soft"><code>{pillar.codeSnippet}</code></pre>
        </div>

        <div data-ui class="ui-panel p-5 text-[15px]">
          <div class="mb-4 flex items-center justify-between gap-3">
            <strong class="font-semibold">{L.pipeline}</strong>
            <span class="text-lime">MP4 + VP9 Alpha + GIF</span>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div class="ui-well p-3">
              <div class="text-muted">9:16</div>
              <div class="tabular font-semibold">1080x1920</div>
            </div>
            <div class="ui-well p-3">
              <div class="text-muted">16:9</div>
              <div class="tabular font-semibold">1920x1080</div>
            </div>
            <div class="ui-well p-3">
              <div class="text-muted">1:1</div>
              <div class="tabular font-semibold">1080x1080</div>
            </div>
          </div>
        </div>

        <figure class="overflow-hidden bg-surface">
          <img
            src="/media/a-colorful-aurora-paints-the-night-sky.jpg"
            width="1280"
            height="1600"
            loading="lazy"
            decoding="async"
            alt="Satellite view of orbital aurora ribbons and night city lights"
            class="aspect-[16/9] w-full object-cover"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="field-surface w-full py-24 md:py-40">
    <div class="frame">
      <h2 class="t-title max-w-[16ch]" data-reveal>{pillar.highlightsTitle[locale]}</h2>
      <div class="mt-14 grid grid-cols-1 gap-3 md:mt-20 md:grid-cols-3">
        {
          pillar.highlights[locale].map((item, idx) => (
            <div
              class:list={['p-7 md:p-9', ['field-lime', 'field-paper', 'field-ground'][idx % 3]]}
              data-reveal
              style={`--reveal-delay: ${idx * 70}ms;`}
            >
              <h3 class="font-display text-[21px] font-extrabold leading-[1.1] tracking-[-0.02em]">{item.title}</h3>
              <p class="mt-5 text-[17px] leading-[1.6]">{item.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FaqDetails heading={L.faq} items={pillar.faqs[locale]} />

  <section class="field-paper w-full py-24 md:py-36">
    <div class="frame">
      <h2 class="t-title" data-reveal>{L.related}</h2>
      <ol class="mt-12 flex flex-col md:mt-16">
        {
          otherPillars.map((other, idx) => (
            <li data-reveal style={`--reveal-delay: ${idx * 70}ms;`}>
              <a
                href={localizePath(`/use-cases/${other.slug}`, locale)}
                class="group grid min-h-[112px] grid-cols-1 items-center gap-2 py-5 transition-[background-color,padding] duration-300 hover:bg-lime md:grid-cols-12 md:gap-8 md:hover:px-6"
              >
                <span class="t-sub md:col-span-5">{other.shortTitle[locale]}</span>
                <span class="text-[17px] leading-[1.5] text-paper-soft group-hover:text-on-lime md:col-span-6">
                  {other.cardSummary[locale]}
                </span>
                <span aria-hidden="true" class="t-sub md:col-span-1 md:text-right">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ActionTileCta locale={locale} />
</BaseLayout>
