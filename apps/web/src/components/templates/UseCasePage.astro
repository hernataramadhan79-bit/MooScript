---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SinglePresetStage from '../islands/SinglePresetStage';
import CopyPromptButton from '../islands/CopyPromptButton';
import FaqIndex from '../islands/FaqIndex';
import ActionTileCta from '../sections/ActionTileCta.astro';
import { SITE_URL, buildStudioUrl, localizePath, type Locale } from '../../config/site';
import { USE_CASE_PILLARS, type UseCasePillar } from '../../data/useCases';

interface Props {
  pillar: UseCasePillar;
  locale: Locale;
}

const { pillar, locale } = Astro.props;
const pathname = localizePath(`/use-cases/${pillar.slug}`, locale);
const otherPillars = USE_CASE_PILLARS.filter((p) => p.slug !== pillar.slug);

const breadcrumbs = [
  { name: 'MooScript', url: new URL(localizePath('/', locale), SITE_URL).toString() },
  {
    name: locale === 'id' ? 'Kegunaan' : 'Use Cases',
    url: new URL(pathname, SITE_URL).toString()
  },
  { name: pillar.shortTitle[locale], url: new URL(pathname, SITE_URL).toString() }
];
---

<BaseLayout
  title={pillar.seoTitle[locale]}
  description={pillar.seoDescription[locale]}
  locale={locale}
  pathname={pathname}
  keywords={pillar.keywords[locale]}
  includeSoftwareSchema={true}
  faqs={pillar.faqs[locale]}
  breadcrumbs={breadcrumbs}
>
  <section class="w-full bg-[#09090b] py-14 md:py-20">
    <div class="mx-auto grid w-full max-w-[1320px] grid-cols-1 gap-10 px-5 md:px-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <h1 class="hero-arrive-1 text-[32px] font-extrabold tracking-tight text-[#f4f4f6] md:text-[42px]">
          {pillar.headline[locale]}
        </h1>
        <p class="hero-arrive-2 mt-5 max-w-[52ch] text-[17px] leading-[1.6] text-[#d4d4d8]">
          {pillar.lead[locale]}
        </p>

        <div class="hero-arrive-3 mt-7 flex flex-wrap items-center gap-3.5">
          <a
            href={buildStudioUrl(pillar.presetSlug)}
            class="inline-flex min-h-[48px] items-center justify-center rounded-md bg-[#84cc16] px-5 text-[15px] font-bold text-[#0e1e00] transition-colors hover:bg-[#9be022]"
          >
            {locale === 'id' ? 'Buka Template di Studio' : 'Open Preset in Studio'} &rarr;
          </a>
          <CopyPromptButton client:visible locale={locale} />
        </div>
      </div>

      <div class="lg:col-span-6">
        <SinglePresetStage client:load slug={pillar.presetSlug} locale={locale} />
      </div>
    </div>
  </section>

  <section class="w-full bg-[#111116] py-20 md:py-24">
    <div class="mx-auto grid w-full max-w-[1320px] grid-cols-1 gap-10 px-5 md:px-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5" data-reveal style="--reveal-delay: 0ms;">
        <h2 class="text-[28px] font-bold text-[#f4f4f6] md:text-[32px]">
          {pillar.architectureTitle[locale]}
        </h2>
        <div class="mt-5 flex flex-col gap-4">
          {
            pillar.architectureParagraphs[locale].map((para) => (
              <p class="max-w-[52ch] text-[17px] leading-[1.6] text-[#d4d4d8]">{para}</p>
            ))
          }
        </div>

        <figure class="mt-7 overflow-hidden rounded-xl bg-[#09090b]" data-reveal style="--reveal-delay: 80ms;">
          <video
            data-ambient-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/stars-rise-over-la-silla-poster.jpg"
            width="854"
            height="480"
            aria-hidden="true"
            class="h-[210px] w-full object-cover"
          >
            <source src="/media/stars-rise-over-la-silla.webm" type="video/webm" />
          </video>
        </figure>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-7" data-reveal style="--reveal-delay: 120ms;">
        <div class="rounded-xl bg-[#09090b] p-6">
          <div class="mb-3 flex items-center justify-between text-[15px] text-[#a1a1aa]">
            <span>{pillar.codeTitle[locale]}</span>
            <code>MooTween API</code>
          </div>
          <pre class="overflow-x-auto text-[13px] leading-[1.6] text-[#e4e4e7]"><code>{pillar.codeSnippet}</code></pre>
        </div>

        <div data-ui class="ui-panel bg-[#09090b] p-4 text-[13px]">
          <div class="mb-3 flex items-center justify-between">
            <strong class="font-semibold text-[#f4f4f6]">WebCodecs Render Pipeline</strong>
            <code class="text-[12px] text-[#84cc16]">MP4 + VP9 Alpha + GIF</code>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">9:16 Vertical</div>
              <code class="text-[12px] text-[#f4f4f6]">1080x1920</code>
            </div>
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">16:9 Landscape</div>
              <code class="text-[12px] text-[#f4f4f6]">1920x1080</code>
            </div>
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">1:1 Square</div>
              <code class="text-[12px] text-[#f4f4f6]">1080x1080</code>
            </div>
          </div>
        </div>

        <figure class="overflow-hidden rounded-xl bg-[#09090b]">
          <img
            src="/media/a-colorful-aurora-paints-the-night-sky.jpg"
            width="1280"
            height="1600"
            loading="lazy"
            decoding="async"
            alt="Satellite view of orbital aurora ribbons and night city lights"
            class="h-[180px] w-full object-cover"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="w-full bg-[#09090b] py-20 md:py-24">
    <div class="mx-auto w-full max-w-[1320px] px-5 md:px-10">
      <h2 class="text-[28px] font-bold text-[#f4f4f6] md:text-[32px]" data-reveal style="--reveal-delay: 0ms;">
        {pillar.highlightsTitle[locale]}
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          pillar.highlights[locale].map((item, idx) => (
            <div
              class="rounded-xl bg-[#111116] p-6"
              data-reveal
              style={`--reveal-delay: ${idx * 70}ms;`}
            >
              <h3 class="text-[20px] font-bold text-[#f4f4f6]">{item.title}</h3>
              <p class="mt-3 text-[17px] leading-[1.6] text-[#d4d4d8]">{item.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="w-full bg-[#111116] py-20 md:py-24">
    <div class="mx-auto w-full max-w-[1320px] px-5 md:px-10" data-reveal style="--reveal-delay: 0ms;">
      <FaqIndex
        client:visible
        heading={locale === 'id' ? 'Pertanyaan umum' : 'Common questions'}
        items={pillar.faqs[locale]}
      />
    </div>
  </section>

  <section class="w-full bg-[#09090b] pt-16">
    <div class="mx-auto w-full max-w-[1320px] px-5 md:px-10" data-reveal style="--reveal-delay: 0ms;">
      <h2 class="mb-6 text-[24px] font-bold text-[#f4f4f6]">
        {locale === 'id' ? 'Alur produksi lainnya' : 'Related workflows'}
      </h2>
      <table class="spec-lineup text-left text-[17px]">
        <tbody>
          {
            otherPillars.map((other) => (
              <tr>
                <td class="pr-4 font-bold text-[#f4f4f6]">
                  <a href={localizePath(`/use-cases/${other.slug}`, locale)} class="hover:text-[#84cc16]">
                    {other.shortTitle[locale]}
                  </a>
                </td>
                <td class="hidden pr-4 text-[#a1a1aa] sm:table-cell">{other.cardSummary[locale]}</td>
                <td class="text-right font-semibold text-[#84cc16]">
                  <a href={localizePath(`/use-cases/${other.slug}`, locale)}>&rarr;</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <ActionTileCta locale={locale} />
</BaseLayout>
