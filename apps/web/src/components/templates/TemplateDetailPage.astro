---
import { SHOWCASE_PRESETS, type MooShowcasePreset } from '@mooscript/presets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../sections/Breadcrumbs.astro';
import SinglePresetStage from '../islands/SinglePresetStage';
import ActionTileCta from '../sections/ActionTileCta.astro';
import { SITE_URL, localizePath, type Locale } from '../../config/site';

interface Props {
  preset: MooShowcasePreset;
  locale: Locale;
}

const { preset, locale } = Astro.props;
const id = locale === 'id';
const pathname = localizePath(`/templates/${preset.slug}`, locale);
const otherPresets = SHOWCASE_PRESETS.filter((p) => p.slug !== preset.slug);

const breadcrumbs = [
  { name: 'MooScript', url: new URL(localizePath('/', locale), SITE_URL).toString() },
  { name: id ? 'Template' : 'Templates', url: new URL(localizePath('/templates', locale), SITE_URL).toString() },
  { name: preset.title[locale], url: new URL(pathname, SITE_URL).toString() }
];

const trail = [
  { name: 'MooScript', href: localizePath('/', locale) },
  { name: id ? 'Template' : 'Templates', href: localizePath('/templates', locale) },
  { name: preset.title[locale] }
];

const L = {
  how: id ? 'Cara kerja kodenya' : 'How the code works',
  more: id ? 'Template lainnya' : 'More templates',
  shot: id ? 'Adegan' : 'Shot'
};
---

<BaseLayout
  title={preset.seoTitle[locale]}
  description={preset.summary[locale]}
  locale={locale}
  pathname={pathname}
  keywords={preset.targetKeywords[locale]}
  includeSoftwareSchema={true}
  breadcrumbs={breadcrumbs}
>
  <section class="field-lime w-full pb-20 pt-4 md:pb-28">
    <div class="frame">
      <Breadcrumbs trail={trail} />
      <h1 class="t-poster arrive mt-10" style="--d: 60ms;">{preset.title[locale]}</h1>
      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-14">
        <div class="lg:col-span-5">
          <p class="t-lead arrive max-w-[40ch]" style="--d: 180ms;">{preset.summary[locale]}</p>
        </div>
        <div data-ui class="lg:col-span-7">
          <SinglePresetStage client:load slug={preset.slug} locale={locale} tone="lime" />
        </div>
      </div>
    </div>
  </section>

  <section class="field-ground w-full py-24 md:py-40">
    <div class="frame grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <h2 class="t-sub" data-reveal>{L.how}</h2>
        <ol class="mt-10 flex list-decimal flex-col gap-6 pl-6 text-[17px] leading-[1.6] text-soft marker:font-bold marker:text-lime">
          {preset.howItWorks[locale].map((point) => <li class="pl-2" data-reveal>{point}</li>)}
        </ol>

      </div>

      <div class="flex flex-col gap-5 lg:col-span-7" data-reveal style="--reveal-delay: 100ms;">
        {
          preset.shots.map((shot, idx) => (
            <div class="bg-surface p-6">
              <div class="mb-3 flex items-center justify-between text-[15px] text-muted">
                <span class="font-semibold text-ink">
                  {L.shot} {idx + 1}
                </span>
                <span class="tabular">{shot.durationInSeconds}s</span>
              </div>
              <pre class="max-h-[380px] overflow-auto text-[15px] leading-[1.6] text-soft"><code>{shot.buildJs}</code></pre>
            </div>
          ))
        }
      </div>
    </div>

    <div class="frame mt-16 grid grid-cols-1 gap-3 md:mt-24 md:grid-cols-2">
        <figure class="overflow-hidden bg-surface" data-reveal>
          <video
            data-ambient-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/stars-rise-over-la-silla-poster.jpg"
            width="854"
            height="480"
            aria-hidden="true"
            class="aspect-video w-full object-cover"
          >
            <source src="/media/stars-rise-over-la-silla.webm" type="video/webm" />
          </video>
        </figure>

        <figure class="overflow-hidden bg-surface" data-reveal>
          <img
            src="/media/a-colorful-aurora-paints-the-night-sky.jpg"
            width="1280"
            height="1600"
            loading="lazy"
            decoding="async"
            alt="Satellite view of orbital aurora ribbons and night city lights"
            class="aspect-video w-full object-cover"
          />
        </figure>
    </div>
  </section>

  <section class="field-paper w-full py-24 md:py-36">
    <div class="frame">
      <h2 class="t-title" data-reveal>{L.more}</h2>
      <ol class="mt-12 flex flex-col md:mt-16">
        {
          otherPresets.map((item, idx) => (
            <li data-reveal style={`--reveal-delay: ${idx * 70}ms;`}>
              <a
                href={localizePath(`/templates/${item.slug}`, locale)}
                class="group grid min-h-[112px] grid-cols-1 items-center gap-2 py-5 transition-[background-color,padding] duration-300 hover:bg-lime md:grid-cols-12 md:gap-8 md:hover:px-6"
              >
                <span class="t-sub md:col-span-5">{item.title[locale]}</span>
                <span class="text-[17px] leading-[1.5] text-paper-soft group-hover:text-on-lime md:col-span-6">
                  {item.summary[locale]}
                </span>
                <span class="tabular text-[17px] font-bold md:col-span-1 md:text-right">{item.aspectRatio}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ActionTileCta locale={locale} />
</BaseLayout>
