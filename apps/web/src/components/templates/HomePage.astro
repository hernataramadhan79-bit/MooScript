---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../sections/HeroSection.astro';
import FormatTicker from '../sections/FormatTicker.astro';
import ShowcaseStudio from '../islands/ShowcaseStudio';
import HowSlider from '../islands/HowSlider';
import FeatureFields from '../sections/FeatureFields.astro';
import CompareSection from '../sections/CompareSection.astro';
import GuidesList from '../sections/GuidesList.astro';
import FaqDetails from '../sections/FaqDetails.astro';
import ActionTileCta from '../sections/ActionTileCta.astro';
import { localizePath, type Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';
import { FAQS } from '../../data/faqs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale];
const faqs = FAQS[locale];
const pathname = localizePath('/', locale);
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDescription}
  locale={locale}
  pathname={pathname}
  includeSoftwareSchema={true}
  faqs={faqs}
>
  <HeroSection locale={locale} />
  <FormatTicker locale={locale} />

  <section id="showcase" class="field-lime w-full pb-24 pt-20 md:pb-36 md:pt-28">
    <div class="frame">
      <ShowcaseStudio client:visible locale={locale} />
    </div>
  </section>

  <section id="how" class="w-full">
    <HowSlider client:visible locale={locale} />
  </section>

  <FeatureFields locale={locale} />
  <CompareSection locale={locale} />
  <GuidesList locale={locale} />
  <FaqDetails heading={copy.faqHeading} items={faqs} />
  <ActionTileCta locale={locale} />
</BaseLayout>
