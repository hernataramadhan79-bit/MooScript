---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../sections/HeroSection.astro';
import PresetShowcase from '../islands/PresetShowcase';
import AiWorkflowSection from '../sections/AiWorkflowSection.astro';
import EngineInspectorPlate from '../islands/EngineInspectorPlate';
import ComparisonMatrix from '../sections/ComparisonMatrix.astro';
import UseCasePillarStrip from '../sections/UseCasePillarStrip.astro';
import FaqIndex from '../islands/FaqIndex';
import ActionTileCta from '../sections/ActionTileCta.astro';
import { localizePath, type Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';
import { FAQS } from '../../data/faqs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale];
const faqs = FAQS[locale];
const pathname = localizePath('/', locale);
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDescription}
  locale={locale}
  pathname={pathname}
  includeSoftwareSchema={true}
  faqs={faqs}
>
  <HeroSection locale={locale} />

  <section id="showcase" class="w-full bg-[#09090b] py-20 md:py-28">
    <div class="mx-auto w-full max-w-[1320px] px-5 md:px-10" data-reveal style="--reveal-delay: 0ms;">
      <PresetShowcase client:visible locale={locale} />
    </div>
  </section>

  <AiWorkflowSection locale={locale} />

  <section id="engine" class="w-full bg-[#09090b] py-20 md:py-28">
    <div class="mx-auto w-full max-w-[1320px] px-5 md:px-10" data-reveal style="--reveal-delay: 0ms;">
      <EngineInspectorPlate client:visible locale={locale} />
    </div>
  </section>

  <ComparisonMatrix locale={locale} />

  <UseCasePillarStrip locale={locale} />

  <section id="faq" class="w-full bg-[#111116] py-20 md:py-28">
    <div class="mx-auto w-full max-w-[1320px] px-5 md:px-10" data-reveal style="--reveal-delay: 0ms;">
      <FaqIndex
        client:visible
        heading={locale === 'id' ? 'Pertanyaan teknis' : 'Technical questions'}
        items={faqs}
      />
    </div>
  </section>

  <ActionTileCta locale={locale} />
</BaseLayout>
