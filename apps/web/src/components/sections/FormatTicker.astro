---
import { HOME_COPY } from '../../data/homeCopy';
import type { Locale } from '../../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = HOME_COPY[locale].ticker;
---

<div class="marquee field-paper w-full overflow-hidden" aria-hidden="true">
  <div class="marquee-track flex w-max items-center py-5 md:py-7">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {[...items, ...items].map((label) => (
            <li class="flex items-center t-poster !leading-none">
              <span class="px-[0.35em]">{label}</span>
              <span class="inline-block h-[0.28em] w-[0.28em] bg-on-paper" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
