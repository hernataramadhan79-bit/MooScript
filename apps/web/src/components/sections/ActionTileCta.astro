---
import LiveStage from '../islands/LiveStage';
import { STUDIO_URL, localizePath, type Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].cta;
---

<section class="field-lime w-full py-20 md:py-32">
  <div class="frame">
    <h2 class="t-poster" data-reveal>{copy.heading}</h2>

    <div class="mt-14 grid grid-cols-1 gap-12 lg:mt-20 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-5" data-reveal style="--reveal-delay: 120ms;">
        <p class="t-lead max-w-[38ch]">{copy.body}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={STUDIO_URL} class="btn btn-dark">{copy.primary} &rarr;</a>
          <a href={localizePath('/templates', locale)} class="btn bg-on-lime/15 text-on-lime hover:bg-on-lime/25">
            {copy.secondary}
          </a>
        </div>
        <p class="mt-5 text-[15px] font-semibold">{copy.after}</p>
      </div>

      <div data-ui class="relative aspect-[16/10] overflow-hidden bg-ground lg:col-span-7" data-reveal style="--reveal-delay: 200ms;">
        <img
          src="/media/glacier-bay-entrance-night-sky-with-aurora.jpg"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          alt={copy.photoAlt}
          class="absolute inset-0 h-full w-full object-cover"
        />
        <LiveStage
          client:visible
          slug="kinetic-typography"
          clear
          fit="cover"
          anchorY={0.45}
          title="Transparent MooTween shot over aurora footage"
          className="absolute inset-0"
        />
      </div>
    </div>
  </div>
</section>
