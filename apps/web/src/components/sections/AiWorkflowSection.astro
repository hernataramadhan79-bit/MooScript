---
import CopyPromptButton from '../islands/CopyPromptButton';
import type { Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].aiWorkflow;

const promptPreview = `ROLE: MooScript Motion Director
ENGINE: HTML/SVG + Scoped CSS + MooTween (zero GSAP)
RULES:
- Paint primary subject at t = 0
- Drive camera via ctx.cameraMove('.moo-camera', ...)
- Sync spoken beats via ctx.wordBeat(sel, word, opts)`;
---

<section id="ai-workflow" class="w-full bg-[#111116] py-20 md:py-28">
  <div class="mx-auto grid w-full max-w-[1320px] grid-cols-1 gap-12 px-5 md:px-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5" data-reveal style="--reveal-delay: 0ms;">
      <h2 class="text-[28px] font-bold text-[#f4f4f6] md:text-[32px]">{copy.heading}</h2>
      <p class="mt-4 max-w-[44ch] text-[17px] leading-[1.6] text-[#d4d4d8]">
        {copy.stepTwoResponseDetail}
      </p>

      <div class="mt-6">
        <CopyPromptButton client:visible locale={locale} />
      </div>

      <figure class="mt-8 overflow-hidden rounded-xl bg-[#09090b]" data-reveal style="--reveal-delay: 90ms;">
        <video
          data-ambient-video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/media/stars-rise-over-la-silla-poster.jpg"
          width="854"
          height="480"
          aria-hidden="true"
          class="h-[230px] w-full object-cover"
        >
          <source src="/media/stars-rise-over-la-silla.webm" type="video/webm" />
        </video>
        <figcaption class="px-4 py-3 text-[15px] text-[#a1a1aa]">
          {locale === 'id'
            ? 'B-roll video lokal 300 MB berjalan di bawah lapisan vektor SVG transparan.'
            : 'Local 300 MB B-roll footage decoded under transparent SVG vector layers.'}
        </figcaption>
      </figure>
    </div>

    <div class="flex flex-col gap-10 lg:col-span-7">
      <div data-reveal style="--reveal-delay: 60ms;">
        <p class="text-[20px] font-semibold text-[#f4f4f6]">{copy.stepOneLead}</p>
        <div class="mt-3 rounded-lg bg-[#09090b] p-5">
          <div class="mb-2 flex items-center justify-between text-[15px] text-[#a1a1aa]">
            <span>{copy.stepOneCodeCaption}</span>
            <code>Claude / ChatGPT / Gemini</code>
          </div>
          <pre class="overflow-x-auto text-[13px] leading-[1.55] text-[#e4e4e7]"><code>{promptPreview}</code></pre>
        </div>
      </div>

      <div class="lg:pl-8" data-reveal style="--reveal-delay: 130ms;">
        <p class="text-[20px] font-semibold text-[#f4f4f6]">{copy.stepTwoLead}</p>
        <div data-ui class="ui-panel mt-3 bg-[#09090b] p-4 text-[13px]">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <strong class="font-semibold text-[#f4f4f6]">{copy.stepTwoResponseTitle}</strong>
            <code class="rounded bg-[#18260c] px-2 py-0.5 text-[12px] text-[#84cc16]">LINT SCORE 0 / PASS</code>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">Camera Rig</div>
              <code class="text-[12px] text-[#f4f4f6]">1.08x &rarr; 1.00x</code>
            </div>
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">Word Beats</div>
              <code class="text-[12px] text-[#f4f4f6]">6 synced</code>
            </div>
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">Auto-SFX</div>
              <code class="text-[12px] text-[#f4f4f6]">whoosh + pop</code>
            </div>
            <div class="ui-well p-2.5">
              <div class="text-[12px] text-[#a1a1aa]">Beat Grid</div>
              <code class="text-[12px] text-[#84cc16]">Locked 124 BPM</code>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 200ms;">
        <p class="text-[20px] font-semibold text-[#f4f4f6]">{copy.stepThreeLead}</p>
        <div data-ui class="ui-panel mt-3 bg-[#09090b] p-4 text-[13px]">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <strong class="font-semibold text-[#f4f4f6]">WebCodecs Hardware Queue</strong>
            <code class="text-[12px] text-[#84cc16]">VideoEncoder + AudioEncoder</code>
          </div>
          <div class="flex flex-wrap gap-2">
            {
              copy.stepThreeFormats.map((fmt) => (
                <span class="ui-chip px-3 py-1.5 text-[12px] font-medium text-[#e4e4e7]">{fmt}</span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
