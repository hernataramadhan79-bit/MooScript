---
import LiveStage from '../islands/LiveStage';
import HeroRail from '../islands/HeroRail';
import { STUDIO_URL, localizePath, type Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].hero;
const fullTitle = `${copy.lineOne} ${copy.lineTwoBefore} ${copy.lineTwoAfter}`;

const masters = [
  { slug: 'kinetic-typography', label: copy.masters[0], box: 'aspect-[9/16]' },
  { slug: 'data-chart-animation', label: copy.masters[1], box: 'aspect-[16/9]' },
  { slug: 'faceless-shorts-hook', label: copy.masters[2], box: 'aspect-[9/16]' }
];
---

<section class="field-ground w-full">
  <div class="frame flex min-h-[calc(100svh-72px)] flex-col justify-between gap-12 pb-12 pt-6 md:pb-14 md:pt-10">
    <h1
      aria-label={fullTitle}
      class="t-poster max-[639px]:text-[44px]"
    >
      <span aria-hidden="true" class="line-mask" style="--d: 40ms;"><span>{copy.lineOne}</span></span>
      <span aria-hidden="true" class="line-mask" style="--d: 160ms;">
        <span class="flex items-baseline gap-x-[0.2em]">
          <span>{copy.lineTwoBefore}</span>
          <span
            class="shutter relative inline-block h-[0.74em] w-[2.35em] shrink-0 self-baseline overflow-hidden bg-surface"
            style="--d: 520ms;"
          >
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="/media/stars-rise-over-la-silla-poster.jpg"
              width="854"
              height="480"
              aria-hidden="true"
              class="absolute inset-0 h-full w-full object-cover"
              data-ambient-video
            >
              <source src="/media/stars-rise-over-la-silla.webm" type="video/webm" />
            </video>
            <LiveStage
              client:load
              slug="kinetic-typography"
              fit="cover"
              clear
              shared
              title={copy.slotAlt}
              className="absolute inset-0"
            />
          </span>
          <span>{copy.lineTwoAfter}</span>
        </span>
      </span>
    </h1>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start lg:gap-8">
      <div class="arrive lg:col-span-4" style="--d: 700ms;">
        <p class="t-lead max-w-[40ch] text-soft">{copy.subheadline}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={STUDIO_URL} class="btn btn-lime">{copy.primaryCta} &rarr;</a>
          <a href={localizePath('/templates', locale)} class="btn btn-quiet">{copy.secondaryCta}</a>
        </div>
        <p class="mt-5 text-[15px] text-muted">{copy.specLine}</p>
      </div>

      <div class="arrive field-lime p-4 sm:p-6 lg:col-span-8" style="--d: 850ms;">
        <p class="mb-4 text-[15px] font-bold">{copy.mastersLabel}</p>
        <div class="flex items-end gap-3 sm:gap-4">
          {
            masters.map((m) => (
              <figure class='m-0 min-w-0'
                style={`flex: ${m.box.includes('16/9') ? 1.7778 : 0.5625} 1 0%;`}>
                <div class:list={['w-full bg-surface', m.box]}>
                  <LiveStage
                    client:load
                    slug={m.slug}
                    shared
                    fit="cover"
                    title={m.label}
                    className="h-full w-full"
                  />
                </div>
                <figcaption class="mt-2 text-[15px] font-semibold leading-tight">
                  <span>{m.label.split(" ")[0]}</span><span class="hidden sm:inline"> {m.label.split(" ").slice(1).join(" ")}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="mt-5">
          <HeroRail
            client:load
            tone="lime"
            playLabel={copy.railPlay}
            pauseLabel={copy.railPause}
            frameLabel={copy.railFrame}
          />
        </div>
        <p class="mt-3 text-[15px]">{copy.railLabel}</p>
      </div>
    </div>
  </div>
</section>
