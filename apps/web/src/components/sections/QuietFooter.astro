---
import { GITHUB_URL, STUDIO_URL, RELEASE_VERSION, localizePath, type Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';
import { USE_CASE_PILLARS } from '../../data/useCases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].footer;
const nav = HOME_COPY[locale].nav;

const linkClass = 'inline-flex min-h-[36px] items-center text-[17px] text-soft transition-colors hover:text-lime';
---

<footer class="relative w-full overflow-hidden bg-ground">
  <div class="frame pt-28 md:pt-40">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-6">
        <p class="t-title max-w-[16ch]">
          {copy.invite}
        </p>
        <a href={STUDIO_URL} class="btn btn-lime mt-9">{nav.launchStudio} &rarr;</a>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 md:col-span-6">
        <div>
          <p class="text-[17px] font-bold text-ink">{copy.product}</p>
          <ul class="mt-3 flex flex-col">
            <li><a href={STUDIO_URL} class={linkClass}>{copy.studio}</a></li>
            <li><a href={`${localizePath('/', locale)}#how`} class={linkClass}>{nav.how}</a></li>
            <li><a href={localizePath('/templates', locale)} class={linkClass}>{nav.templates}</a></li>
            <li><a href={localizePath('/use-cases', locale)} class={linkClass}>{nav.useCases}</a></li>
          </ul>
        </div>
        <div>
          <p class="text-[17px] font-bold text-ink">{copy.guides}</p>
          <ul class="mt-3 flex flex-col">
            {
              USE_CASE_PILLARS.map((pillar) => (
                <li>
                  <a href={localizePath(`/use-cases/${pillar.slug}`, locale)} class={linkClass}>
                    {pillar.shortTitle[locale]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="text-[17px] font-bold text-ink">{copy.project}</p>
          <ul class="mt-3 flex flex-col">
            <li>
              <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{nav.github}</a>
            </li>
            <li><a href={localizePath('/privacy', locale)} class={linkClass}>{copy.privacy}</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="mt-20 flex flex-col gap-2 text-[15px] text-muted md:mt-28 md:flex-row md:items-baseline md:justify-between">
      <p>
        {copy.madeIn} <span aria-hidden="true">&middot;</span>
        <span class="tabular">{RELEASE_VERSION}</span>
      </p>
      <p class="max-w-[62ch] md:text-right">{copy.mediaCredits}</p>
    </div>
  </div>

  <div aria-hidden="true" class="pointer-events-none mt-6 select-none whitespace-nowrap px-[var(--page-x)]">
    <div
      class="translate-y-[24%] font-display font-extrabold leading-[0.8] tracking-[-0.05em] text-lime"
      style="font-size: min(11.4vw, 200px);"
    >
      MooScript
    </div>
  </div>
</footer>
