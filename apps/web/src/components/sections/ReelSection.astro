---
import { HOME_COPY } from '../../data/homeCopy';
import type { Locale } from '../../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].reel;
---

<section id="output" class="field-surface w-full py-20 md:py-28" aria-labelledby="output-heading">
  <div class="frame grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4">
      <h2 id="output-heading" class="t-title max-w-[14ch]" data-reveal>{copy.heading}</h2>
      <p class="mt-6 max-w-[36ch] text-[17px] leading-[1.55] text-muted" data-reveal style="--reveal-delay: 80ms;">{copy.body}</p>
      <ul class="mt-8 flex flex-col gap-2 text-[14px]" data-reveal style="--reveal-delay: 140ms;">
        {copy.facts.map((fact) => <li class="font-mono">{fact}</li>)}
      </ul>
    </div>

    <figure class="mx-auto w-full max-w-[300px] lg:col-span-3" data-reveal style="--reveal-delay: 120ms;">
      <video
        class="aspect-[9/16] w-full bg-ground object-cover"
        src="/media/studio-export-reel.mp4"
        poster="/media/studio-export-reel-poster.jpg"
        width="720"
        height="1280"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        data-ambient-video
        aria-label={copy.videoLabel}></video>
      <figcaption class="mt-3 text-[13px] text-muted">{copy.videoCaption}</figcaption>
    </figure>

    <figure class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
      <img
        class="w-full bg-ground"
        src="/media/studio-workspace.webp"
        alt={copy.screenshotAlt}
        width="1440"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mt-3 text-[13px] text-muted">{copy.screenshotCaption}</figcaption>
    </figure>
  </div>
</section>
