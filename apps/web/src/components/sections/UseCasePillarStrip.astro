---
import { localizePath, type Locale } from '../../config/site';
import { HOME_COPY } from '../../data/homeCopy';
import { USE_CASE_PILLARS } from '../../data/useCases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].silos;
---

<section class="w-full bg-[#09090b] py-20 md:py-28">
  <div class="mx-auto grid w-full max-w-[1320px] grid-cols-1 gap-10 px-5 md:px-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5" data-reveal style="--reveal-delay: 0ms;">
      <h2 class="text-[28px] font-bold text-[#f4f4f6] md:text-[32px]">{copy.heading}</h2>
      <p class="mt-3 max-w-[44ch] text-[17px] leading-[1.6] text-[#d4d4d8]">{copy.lead}</p>

      <figure class="mt-8 overflow-hidden rounded-xl bg-[#111116]">
        <img
          src="/media/a-colorful-aurora-paints-the-night-sky.jpg"
          width="1280"
          height="1600"
          loading="lazy"
          decoding="async"
          alt="Satellite night view of orbital aurora ribbons and city lights"
          class="h-[260px] w-full object-cover"
        />
      </figure>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-7">
      {
        USE_CASE_PILLARS.map((pillar, idx) => (
          <a
            href={localizePath(`/use-cases/${pillar.slug}`, locale)}
            data-reveal
            style={`--reveal-delay: ${idx * 70}ms;`}
            class="group flex flex-col justify-between gap-3 rounded-xl bg-[#111116] p-6 transition-colors hover:bg-[#181820] sm:flex-row sm:items-center"
          >
            <div>
              <h3 class="text-[20px] font-bold text-[#f4f4f6] transition-colors group-hover:text-[#84cc16] md:text-[24px]">
                {pillar.shortTitle[locale]}
              </h3>
              <p class="mt-1.5 max-w-[46ch] text-[15px] leading-[1.55] text-[#d4d4d8]">
                {pillar.cardSummary[locale]}
              </p>
            </div>
            <span class="shrink-0 text-[15px] font-semibold text-[#84cc16]">
              {copy.readGuide} &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
