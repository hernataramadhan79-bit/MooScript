{
  "name": "mooscript-monorepo",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mooscript/studio dev",
    "dev:studio": "pnpm --filter @mooscript/studio dev",
    "dev:web": "pnpm --filter @mooscript/web dev",
    "build": "pnpm --filter @mooscript/studio build && pnpm --filter @mooscript/web build",
    "build:studio": "pnpm --filter @mooscript/studio build",
    "build:web": "pnpm --filter @mooscript/web build",
    "preview:studio": "pnpm --filter @mooscript/studio preview",
    "preview:web": "pnpm --filter @mooscript/web preview",
    "test": "pnpm --filter @mooscript/studio test",
    "test:studio": "pnpm --filter @mooscript/studio test",
    "lint": "pnpm --filter @mooscript/studio lint",
    "lint:studio": "pnpm --filter @mooscript/studio lint",
    "typecheck": "pnpm --filter @mooscript/presets typecheck && pnpm --filter @mooscript/studio exec tsc -b && pnpm --filter @mooscript/web check",
    "format": "pnpm --filter @mooscript/studio format"
  }
}
